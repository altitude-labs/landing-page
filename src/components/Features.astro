---
import SectionBadge from './ui/SectionBadge.astro';
import FeatureCard from './ui/FeatureCard.astro';
import backgroundLettersDesktop from '../assets/background-letters-desk.svg';
import backgroundLettersMobile from '../assets/background-letters.svg';
import { Image } from 'astro:assets';
import liveChartVideo from "../assets/live-chart-video.mp4";
import scanFilter from "../assets/scan_and_filter.mp4";
import altitudeFav from "../assets/ALTITUDE_FAV.mp4";
import altitudePortfolio from "../assets/ALTITUDE_PORTFOLIO.mp4";

const chartIcon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f3f2f2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16v5"/><path d="M16 14v7"/><path d="M20 10v11"/><path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"/><path d="M4 18v3"/><path d="M8 14v7"/></svg>')}`;
const filterIcon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f3f2f2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.07 4.93A10 10 0 0 0 6.99 3.34"/><path d="M4 6h.01"/><path d="M2.29 9.62A10 10 0 1 0 21.31 8.35"/><path d="M16.24 7.76A6 6 0 1 0 8.23 16.67"/><path d="M12 18h.01"/><path d="M17.99 11.66A6 6 0 0 1 15.77 16.67"/><circle cx="12" cy="12" r="2"/><path d="m13.41 10.59 5.66-5.66"/></svg>')}`;
const organizeIcon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f3f2f2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.828 14.828 21 21"/><path d="M21 16v5h-5"/><path d="m21 3-9 9-4-4-6 6"/><path d="M21 8V3h-5"/></svg>')}`;
const portfolioIcon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f3f2f2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/></svg>')}`;
---

<section id="features" class="relative py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-primary-dark overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[1200px] h-[800px] lg:hidden">
      <Image src={backgroundLettersMobile} alt="background letters pattern mobile" class="w-full h-full object-contain" loading="lazy" />
    </div>
    <div class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[2151px] h-[1429px] hidden lg:block">
      <Image src={backgroundLettersDesktop} alt="background letters pattern desktop" class="w-full h-full object-contain opacity-60" loading="lazy" />
    </div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="flex flex-col items-center text-center mb-12 md:mb-20">
      <SectionBadge text="Features" />
      <h2 class="text-white font-bold text-2xl md:text-4xl lg:text-5xl leading-tight mb-4 max-w-2xl mx-auto">
        Everything you need.<br/>
        Nothing slowing you down.
      </h2>
    </div>
    <div class="lg:grid lg:grid-cols-2 lg:gap-8 lg:items-center">
      <div class="max-w-md mx-auto md:max-w-2xl lg:max-w-none">
        <div class="w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent mb-5"></div>
        <div class="flex flex-col gap-5 feature-card-wrapper" id="features-list">
          <FeatureCard
            icon={chartIcon}
            title="Spot & memecoin intel"
            description="Scan every token moving on HyperEVM and Solana. Filter by volume, trend, wallet activity. Hit before the crowd."
            media={{ type: 'video', src: liveChartVideo }}
            isExpanded={true}
          />
          <FeatureCard
            icon={filterIcon}
            title="Perpetuals & equities"
            description="Full Hyperliquid perp access, routed through our infrastructure. Sub-second execution. Trade crypto, equities, and commodities via HIP-3 markets."
            media={{ type: 'video', src: scanFilter }}
          />
          <FeatureCard
            icon={organizeIcon}
            title="Prediction markets"
            description="Polymarket and HIP-4 outcomes. Use market consensus as your entry signal on perps. No other terminal does this."
            media={{ type: 'video', src: altitudeFav }}
          />
          <FeatureCard
            icon={portfolioIcon}
            title="Portfolio"
            description="Every position, one screen. Spot, perps, prediction markets. Track your allocation history, monitor open trades, and close positions without leaving the terminal."
            media={{ type: 'video', src: altitudePortfolio }}
          />
        </div>
        <div class="w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent mt-5"></div>
      </div>
      <div class="hidden lg:block">
        <div class="relative aspect-[3/2] bg-secondary-blue rounded-[12px] overflow-hidden media-display-container shadow-2xl">
          <div class="absolute inset-0 bg-gradient-dark rounded-[12px]"></div>
          <img id="feature-image-display" alt="Feature preview" width="600" height="400"
               class="absolute inset-0 w-full h-full object-cover media-display-content transition-all duration-400 ease-out"
               style="transform: translateZ(0);">
          <video id="feature-video-display" autoplay loop muted playsinline preload="metadata"
                 class="absolute inset-0 w-full h-full object-cover media-display-content transition-all duration-400 ease-out opacity-0"
                 style="transform: translateZ(0);"></video>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (window.innerWidth < 1024) return;
  const featuresList = document.getElementById('features-list');
  if (!featuresList) return;
  const featureCards = featuresList.querySelectorAll('.feature-card');
  const imageDisplay = document.getElementById('feature-image-display') as HTMLImageElement | null;
  const videoDisplay = document.getElementById('feature-video-display') as HTMLVideoElement | null;
  if (!imageDisplay || !videoDisplay) return;
  const updateMediaDisplay = (activeCard: Element) => {
    const mediaSrc = (activeCard as HTMLElement).dataset.mediaSrc;
    const mediaType = (activeCard as HTMLElement).dataset.mediaType;
    if (!mediaSrc || !mediaType) return;
    const isImage = mediaType === 'image';
    imageDisplay.style.opacity = '0';
    videoDisplay.style.opacity = '0';
    requestAnimationFrame(() => {
      setTimeout(() => {
        if (isImage) {
          if (imageDisplay.src !== mediaSrc) {
            imageDisplay.src = mediaSrc;
          }
          requestAnimationFrame(() => {
            imageDisplay.style.opacity = '1';
            videoDisplay.pause();
            videoDisplay.currentTime = 0;
          });
        } else {
          if (videoDisplay.src !== mediaSrc) {
            videoDisplay.src = mediaSrc;
          }
          requestAnimationFrame(() => {
            videoDisplay.style.opacity = '1';
            videoDisplay.play().catch(() => {});
          });
        }
      }, 150);
    });
  };
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-expanded') {
        const card = mutation.target as Element;
        const isExpanded = card.getAttribute('data-expanded') === 'true';
        if (isExpanded) {
          updateMediaDisplay(card);
        }
      }
    });
  });
  featureCards.forEach(card => {
    observer.observe(card, { attributes: true, attributeFilter: ['data-expanded'] });
    if (card.getAttribute('data-expanded') === 'true') {
      updateMediaDisplay(card);
    }
  });
  window.addEventListener('beforeunload', () => {
    observer.disconnect();
  });
});
</script>
