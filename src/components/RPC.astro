---
import RPCCard from './ui/RPCCard.astro';
import SectionBadge from './ui/SectionBadge.astro';
---

<section id="rpc-services" class="relative py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-[#020921]">
  <div class="max-w-7xl mx-auto">
    <div class="lg:hidden">
      <div class="flex flex-col items-start mb-12 md:mb-20">
        <div class="mb-10">
          <SectionBadge text="RPC Services" />
        </div>
        <div class="mb-10 max-w-2xl">
          <h2 class="text-white font-bold text-xl md:text-2xl leading-tight mb-4">
            The infrastructure running Altitude? You can use it too.
          </h2>
          <p class="text-light-blue font-medium text-base md:text-lg leading-relaxed tracking-tight">
            20+ institutional clients already do.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="https://rpc.reachaltitude.xyz/" target="_blank" rel="noopener noreferrer" class="border-2 border-primary-blue text-white hover:bg-primary-blue/10 font-medium text-sm px-4 py-2 rounded-lg transition-all duration-200 tracking-tight inline-flex items-center justify-center">
            Learn more
          </a>
          <a href="https://rpc.reachaltitude.xyz/" target="_blank" rel="noopener noreferrer" class="bg-primary-blue hover:bg-opacity-90 text-white font-medium text-sm px-4 py-2 rounded-lg transition-all duration-200 tracking-tight inline-flex items-center justify-center">
            View Plans
          </a>
        </div>
      </div>
      <div class="max-w-md mx-auto md:max-w-2xl">
        <div class="bg-[#050f2f] rounded-[20px] p-2.5">
          <div class="flex flex-col">
            <RPCCard title="Private RPC Endpoints" description="Dedicated throughput, zero congestion. Built for production traffic on Hyperliquid." />
            <div class="h-px bg-gradient-to-r from-transparent via-red-500/60 to-transparent my-2.5"></div>
            <RPCCard title="Sub-second Latency" description="Milliseconds decide trades. Our stack is optimized for MEV, copy trading, and high-frequency use." />
            <div class="h-px bg-gradient-to-r from-transparent via-green-500/60 to-transparent my-2.5"></div>
            <RPCCard title="Custom APIs" description="From EVM indexing to execution logic. We build what your app actually needs." />
            <div class="h-px bg-gradient-to-r from-transparent via-red-500/60 to-transparent my-2.5"></div>
            <RPCCard title="Fully Managed" description="We deploy, monitor, and maintain. You ship." />
          </div>
        </div>
      </div>
    </div>

    <div class="hidden lg:block">
      <div class="mb-10 flex justify-center">
        <SectionBadge text="RPC Services" />
      </div>
      <div class="flex items-center justify-between mb-[100px]">
        <div class="flex-1 max-w-[832px]">
          <h2 class="text-white font-bold text-[48px] leading-[52px]">
            The infrastructure running Altitude?<br /> You can use it too.
          </h2>
        </div>
        <div class="flex flex-col items-end gap-[30px]">
          <p class="text-light-blue font-medium text-[25px] leading-[1.4] tracking-[-0.5px] text-right w-[323px]">
            20+ institutional clients already do.
          </p>
          <div class="flex items-center gap-2.5">
            <a href="https://rpc.reachaltitude.xyz/" target="_blank" rel="noopener noreferrer" class="border-2 border-primary-blue text-white hover:bg-primary-blue/10 font-medium text-base px-[25px] py-3 rounded-lg transition-all duration-200 tracking-[-0.32px] inline-flex items-center justify-center">
              Learn More
            </a>
            <a href="https://rpc.reachaltitude.xyz/" target="_blank" rel="noopener noreferrer" class="bg-primary-blue hover:bg-opacity-90 text-white font-medium text-base px-[25px] py-3 rounded-lg transition-all duration-200 tracking-[-0.32px] inline-flex items-center justify-center">
              View Plans
            </a>
          </div>
        </div>
      </div>
      <div class="bg-[#050f2f] rounded-[20px] p-2.5">
        <div class="flex gap-2.5">
          <div class="flex-1">
            <RPCCard title="Private RPC Endpoints" description="Dedicated throughput, zero congestion. Built for production traffic on Hyperliquid." isDesktop={true} />
          </div>
          <div class="w-px bg-gradient-to-b from-transparent via-red-500/60 to-transparent"></div>
          <div class="flex-1">
            <RPCCard title="Sub-second Latency" description="Milliseconds decide trades. Our stack is optimized for MEV, copy trading, and high-frequency use." isDesktop={true} />
          </div>
          <div class="w-px bg-gradient-to-b from-transparent via-green-500/60 to-transparent"></div>
          <div class="flex-1">
            <RPCCard title="Custom APIs" description="From EVM indexing to execution logic. We build what your app actually needs." isDesktop={true} />
          </div>
          <div class="w-px bg-gradient-to-b from-transparent via-red-500/60 to-transparent"></div>
          <div class="flex-1">
            <RPCCard title="Fully Managed" description="We deploy, monitor, and maintain. You ship." isDesktop={true} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
